# Optional. When set, the app generates a personalized Taoist reflection with Claude.
# Without it, the app still works fully offline using its curated library of passages.
#
# Copy this file to .env.local and fill in your key:
#   cp .env.local.example .env.local
#
# (You can also authenticate with `ant auth login` instead of a key — the zero-arg
#  Anthropic client will pick up the profile automatically.)
ANTHROPIC_API_KEY=
